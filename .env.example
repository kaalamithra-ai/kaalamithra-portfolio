# ─────────────────────────────────────────────────────────────────────────────
# Contact form delivery — copy this file to `.env.local` and fill in ONE option.
# Submissions are received by `app/api/contact/route.ts`.
# ─────────────────────────────────────────────────────────────────────────────

# OPTION A (recommended) — email via Resend: https://resend.com/api-keys
# Leave blank to disable and fall through to Option B.
RESEND_API_KEY=

# Where enquiry emails are delivered.
CONTACT_TO_EMAIL=tech@kaalamithra-ai.com

# Verified sender. `onboarding@resend.dev` works for testing without a domain;
# once kaalamithra-ai.com is verified in Resend use e.g.
# "KAALAMITHRA Website <website@kaalamithra-ai.com>"
CONTACT_FROM_EMAIL=KAALAMITHRA Website <onboarding@resend.dev>

# OPTION B — POST each enquiry as JSON to any webhook endpoint.
# Works with Formspree, Zapier, Make, Google Apps Script, Slack, n8n, etc.
CONTACT_WEBHOOK_URL=

# OPTIONAL — set to "false" to stop writing `.data/contact-enquiries.jsonl`.
# That file is a local safety net when no provider is configured; it is never
# written on Vercel (ephemeral filesystem).
CONTACT_FILE_BACKUP=true
